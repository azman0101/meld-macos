+import sys
+
 from gi.repository import Gdk, Gio, GObject
 
 from meld.settings import load_settings_schema
@@ -53,9 +55,42 @@ class SavedWindowState(GObject.GObject):
         self.settings.bind('is-maximized', self, 'is-maximized', bind_flags)
 
         window.set_default_size(self.props.width, self.props.height)
+        if sys.platform == "darwin":
+            # GTK's quartz backend neither keeps a restored window on screen
+            # nor places it sensibly, so a size saved on a larger display
+            # leaves the title bar under the menu bar (#966).
+            window.connect("map-event", self.on_map_fit_to_workarea)
         if self.props.is_maximized:
             window.maximize()
 
+    def on_map_fit_to_workarea(self, window, event):
+        window.disconnect_by_func(self.on_map_fit_to_workarea)
+        if self.props.is_maximized or self.props.is_fullscreen:
+            return False
+
+        gdk_window = window.get_window()
+        display = window.get_display()
+        monitor = display.get_primary_monitor() or display.get_monitor(0)
+        if gdk_window is None or monitor is None:
+            return False
+
+        workarea = monitor.get_workarea()
+        frame = gdk_window.get_frame_extents()
+        width, height = window.get_size()
+        # Client-side decorations: header bar and shadows
+        decoration_width = frame.width - width
+        decoration_height = frame.height - height
+
+        fit_width = min(width, workarea.width - decoration_width)
+        fit_height = min(height, workarea.height - decoration_height)
+        if (fit_width, fit_height) != (width, height):
+            window.resize(fit_width, fit_height)
+
+        x = workarea.x + (workarea.width - fit_width - decoration_width) // 2
+        y = workarea.y + (workarea.height - fit_height - decoration_height) // 2
+        gdk_window.move(x, y)
+        return False
+
     def on_size_allocate(self, window, allocation):
         if not (self.props.is_maximized or self.props.is_fullscreen):
             width, height = window.get_size()
