+        if sys.platform == "darwin":
+            # The client-side decoration shadow is part of the NSWindow, so
+            # macOS keeps it on screen: the visible window can never reach
+            # the screen edges. Drop the shadow, keep a thin resize border.
+            provider = Gtk.CssProvider()
+            provider.load_from_data(
+                b"decoration { box-shadow: none; margin: 0; }"
+                b" window.csd decoration { padding: 2px; }")
+            Gtk.StyleContext.add_provider_for_screen(
+                Gdk.Screen.get_default(), provider,
+                Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)
