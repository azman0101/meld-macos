+"""Native macOS window fullscreen.
+
+GTK 3's quartz backend does not fullscreen a window: gtk_window_fullscreen()
+moves it off screen. The native NSWindow fullscreen works, so use it.
+"""
+
+import ctypes
+import ctypes.util
+
+NS_WINDOW_STYLE_MASK_FULL_SCREEN = 1 << 14
+
+_objc = ctypes.CDLL(ctypes.util.find_library("objc"))
+_objc.sel_registerName.restype = ctypes.c_void_p
+_objc.sel_registerName.argtypes = [ctypes.c_char_p]
+_msg_send = ctypes.cast(_objc.objc_msgSend, ctypes.c_void_p).value
+
+# objc_msgSend must be called with the exact method signature on arm64
+_send_ulong = ctypes.CFUNCTYPE(
+    ctypes.c_ulong, ctypes.c_void_p, ctypes.c_void_p)(_msg_send)
+_send_void_id = ctypes.CFUNCTYPE(
+    None, ctypes.c_void_p, ctypes.c_void_p, ctypes.c_void_p)(_msg_send)
+
+_capsule_pointer = ctypes.pythonapi.PyCapsule_GetPointer
+_capsule_pointer.restype = ctypes.c_void_p
+_capsule_pointer.argtypes = [ctypes.py_object, ctypes.c_char_p]
+
+
+def _load_gdk():
+    libsystem = ctypes.CDLL(None)
+    libsystem._dyld_image_count.restype = ctypes.c_uint32
+    libsystem._dyld_get_image_name.restype = ctypes.c_char_p
+    libsystem._dyld_get_image_name.argtypes = [ctypes.c_uint32]
+    for i in range(libsystem._dyld_image_count()):
+        name = libsystem._dyld_get_image_name(i)
+        if name and b"libgdk-3" in name:
+            gdk = ctypes.CDLL(name.decode())
+            gdk.gdk_quartz_window_get_nswindow.restype = ctypes.c_void_p
+            gdk.gdk_quartz_window_get_nswindow.argtypes = [ctypes.c_void_p]
+            return gdk
+    raise OSError("libgdk-3 is not loaded")
+
+
+_gdk = _load_gdk()
+
+
+def _nswindow(window):
+    gdk_window = _capsule_pointer(window.get_window().__gpointer__, None)
+    return _gdk.gdk_quartz_window_get_nswindow(gdk_window)
+
+
+def is_fullscreen(window):
+    style_mask = _send_ulong(
+        _nswindow(window), _objc.sel_registerName(b"styleMask"))
+    return bool(style_mask & NS_WINDOW_STYLE_MASK_FULL_SCREEN)
+
+
+def toggle_fullscreen(window):
+    _send_void_id(
+        _nswindow(window), _objc.sel_registerName(b"toggleFullScreen:"),
+        None)
