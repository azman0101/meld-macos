 from gi.repository import Gdk, Gio, GLib, Gtk
@@ -261,6 +262,15 @@
             page.on_delete_event()
 
     def action_fullscreen_change(self, action, state):
+        if sys.platform == "darwin":
+            # GTK's quartz backend moves the window off screen instead of
+            # fullscreening it; the native fullscreen can also be left
+            # without this action, so follow the real window state.
+            import meld.macos
+            full = not meld.macos.is_fullscreen(self)
+            action.set_state(GLib.Variant.new_boolean(full))
+            meld.macos.toggle_fullscreen(self)
+            return
         window_state = self.get_window().get_state()
         is_full = window_state & Gdk.WindowState.FULLSCREEN
         action.set_state(state)
