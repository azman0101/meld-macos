+    def use_native_title_bar(self):
+        """Use the macOS title bar instead of a client-side one
+
+        With a header bar as its titlebar, GTK's quartz backend draws its
+        own window buttons: the window has no red/yellow/green buttons, so
+        it can't be moved to another display or zoomed like any other, and
+        it is moved by GTK instead of by macOS. Keep the header bar, but as
+        the first widget of the window, below the native title bar.
+        """
+        header_bar = self.get_titlebar()
+        if header_bar is None:
+            return
+        self.set_titlebar(None)
+        header_bar.set_show_close_button(False)
+        header_bar.set_title("")
+        header_bar.get_style_context().remove_class(Gtk.STYLE_CLASS_TITLEBAR)
+        self.appvbox.pack_start(header_bar, False, True, 0)
+        self.appvbox.reorder_child(header_bar, 0)
+
     def do_realize(self):
         Gtk.ApplicationWindow.do_realize(self)
 
