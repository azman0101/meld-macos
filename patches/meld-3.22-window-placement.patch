+    def on_map_fit_to_workarea(self, window, event):
+        window.disconnect_by_func(self.on_map_fit_to_workarea)
+        if self.props.is_maximized or self.props.is_fullscreen:
+            return False
+        self.fit_to_workarea(window, *window.get_size())
+        return False
+
+    def on_window_state_fullscreen(self, window, event):
+        if not event.changed_mask & Gdk.WindowState.FULLSCREEN:
+            return False
+        if event.new_window_state & Gdk.WindowState.FULLSCREEN:
+            self.pre_fullscreen = (
+                self.props.width, self.props.height, window.get_position())
+        elif self.pre_fullscreen:
+            # Let the quartz backend finish leaving fullscreen first
+            GLib.timeout_add(300, self.restore_pre_fullscreen, window)
+        return False
+
+    def restore_pre_fullscreen(self, window):
+        width, height, position = self.pre_fullscreen
+        self.pre_fullscreen = None
+        if not window.is_maximized():
+            self.fit_to_workarea(window, width, height, position)
+            self.props.width, self.props.height = width, height
+        return GLib.SOURCE_REMOVE
+
+    def fit_to_workarea(self, window, width, height, position=None):
+        """Resize and move the window to fit in the screen's work area
+
+        The window is centred, or kept at position if it fits there.
+        """
+        gdk_window = window.get_window()
+        display = window.get_display()
+        monitor = display.get_primary_monitor() or display.get_monitor(0)
+        if gdk_window is None or monitor is None:
+            return False
+
+        workarea = monitor.get_workarea()
+        frame = gdk_window.get_frame_extents()
+        current_width, current_height = window.get_size()
+        # Client-side decorations: header bar and shadows
+        decoration_width = frame.width - current_width
+        decoration_height = frame.height - current_height
+
+        fit_width = min(width, workarea.width - decoration_width)
+        fit_height = min(height, workarea.height - decoration_height)
+        if (fit_width, fit_height) != (current_width, current_height):
+            window.resize(fit_width, fit_height)
+
+        outer_width = fit_width + decoration_width
+        outer_height = fit_height + decoration_height
+        x = workarea.x + (workarea.width - outer_width) // 2
+        y = workarea.y + (workarea.height - outer_height) // 2
+        if position is not None:
+            px, py = position
+            if (workarea.x <= px <= workarea.x + workarea.width - outer_width
+                    and workarea.y <= py <=
+                    workarea.y + workarea.height - outer_height):
+                x, y = px, py
+        gdk_window.move(x, y)
+
     def on_size_allocate(self, window, allocation):
         if not (self.props.is_maximized or self.props.is_fullscreen):
